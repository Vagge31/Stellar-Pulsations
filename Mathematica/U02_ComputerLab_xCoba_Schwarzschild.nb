Cell[CellGroupData[{

Cell["Geodesic Equations", "Section",
 CellChangeTimes->{{3.8887320898488607`*^9, 
  3.888732095210071*^9}},ExpressionUUID->"e65efffe-853a-4d6f-8542-\
e26f7f9dee40"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DefTensor", "[", 
   RowBox[{
    RowBox[{"u", "[", "\[Mu]", "]"}], ",", "M"}], "]"}], ";"}]], "Input",
 CellChangeTimes->{3.888732120825698*^9, 3.888732250251689*^9, 
  3.8887322884122353`*^9},
 CellLabel->"In[38]:=",ExpressionUUID->"c847dc61-0a91-46fe-99f1-1b6467fc980d"],

Cell[TextData[{
 "The geodesic equations are:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox[
      SuperscriptBox["du", "\[Mu]"], "d\[Tau]"], "+", 
     RowBox[{
      SubscriptBox[
       SuperscriptBox["\[CapitalGamma]", "\[Mu]"], 
       RowBox[{"\[Vee]", "\[Rho]"}]], 
      SuperscriptBox["u", "\[Nu]"], 
      SuperscriptBox["u", "\[Rho]"]}]}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "98b7b6f3-8251-4b7c-bba4-3dda9c4b25c4"],
 "\ngeqs is a list with the second term geqs[\[Mu]+1]= ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     SuperscriptBox["\[CapitalGamma]", "\[Mu]"], 
     RowBox[{"\[Vee]", "\[Rho]"}]], 
    SuperscriptBox["u", "\[Nu]"], 
    SuperscriptBox["u", "\[Rho]"]}], TraditionalForm]],ExpressionUUID->
  "8c26d024-bf9d-40f5-b793-a9bbf926bae0"],
 " for each \[Mu]=0,..,d-1.\n(careful, in the expressions below, when e.g.  \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["u", 
     SuperscriptBox["3", "2"]], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      SuperscriptBox["u", "3"], ")"}], "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ee46b622-8811-4f78-81cb-6d6492b54dec"],
 ", the squared terms don\[CloseCurlyQuote]t appear nicely)\n"
}], "Text",
 CellChangeTimes->{{3.888758229628366*^9, 3.888758298509486*^9}, {
  3.888760818192832*^9, 3.8887608880652122`*^9}, {3.888761588873024*^9, 
  3.888761670126086*^9}},ExpressionUUID->"5e8fad85-1920-4da2-8f25-\
8bc48b7f17b8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"geqs", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"ComponentArray", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Christoffel", "[", 
         RowBox[{"CD", ",", "PDch"}], "]"}], "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Mu]", ",", "ch"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "\[Nu]"}], ",", 
           RowBox[{"-", "ch"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "\[Rho]"}], ",", 
           RowBox[{"-", "ch"}]}], "}"}]}], "]"}], " ", 
       RowBox[{"u", "[", 
        RowBox[{"{", 
         RowBox[{"\[Nu]", ",", "ch"}], "}"}], "]"}], 
       RowBox[{"u", "[", 
        RowBox[{"{", 
         RowBox[{"\[Rho]", ",", "ch"}], "}"}], "]"}]}], "]"}], "//", 
     "ContractBasis"}], "//", "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", 
   RowBox[{"i", "<=", " ", 
    RowBox[{"Length", "[", "geqs", "]"}]}], ",", 
   RowBox[{"i", "++"}], ",", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<\!\(\*FractionBox[\(d\), \(d\[Tau]\)]\)\>\"", ",", 
     RowBox[{"u", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"i", "-", "1"}], ",", "ch"}], "}"}], "]"}], ",", "\"\<+(\>\"",
      ",", 
     RowBox[{"geqs", "[", 
      RowBox[{"[", "i", "]"}], "]"}], ",", "\"\<)=0\>\""}], "]"}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.888732299340007*^9, 3.888732326076708*^9}, {
  3.888732433987865*^9, 3.888732488745841*^9}, {3.8887575591419*^9, 
