Cell[BoxData[
 RowBox[{"Print", "[", "\[IndentingNewLine]", 
  RowBox[{"\"\<\!\(\*SubscriptBox[\(g\), \(\[Mu]\[Nu]\)]\)= \>\"", ",", 
   RowBox[{
    RowBox[{"ComponentArray", "[", 
     RowBox[{"g", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "\[Mu]"}], ",", 
         RowBox[{"-", "ch"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "\[Nu]"}], ",", 
         RowBox[{"-", "ch"}]}], "}"}]}], "]"}], "]"}], "//", "MatrixForm"}], 
   ",", "\"\<    ,       \>\"", ",", "\[IndentingNewLine]", 
   "\"\<\!\(\*SuperscriptBox[\(g\), \(\[Mu]\[Nu]\)]\)= \>\"", ",", 
   RowBox[{
    RowBox[{"ComponentArray", "[", 
     RowBox[{"g", "[", 
      RowBox[{
       RowBox[{"{", "  ", 
        RowBox[{"\[Mu]", ",", "   ", "ch"}], "}"}], ",", 
       RowBox[{"{", "   ", 
        RowBox[{"\[Nu]", ",", "  ", "ch"}], "}"}]}], "]"}], "]"}], "//", 
    "MatrixForm"}], ",", "\"\<\\n\>\"", ",", "\[IndentingNewLine]", 
   "\"\<g = \>\"", ",", " ", 
   RowBox[{
    RowBox[{"Determinant", "[", 
     RowBox[{"g", ",", "ch"}], "]"}], "[", "]"}], ",", "\"\< = \>\"", ",", 
   RowBox[{
    RowBox[{"Det", "[", 
     RowBox[{"ComponentArray", "[", 
      RowBox[{"g", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "\[Mu]"}], ",", 
          RowBox[{"-", "ch"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "\[Nu]"}], ",", 
          RowBox[{"-", "ch"}]}], "}"}]}], "]"}], "]"}], "]"}], "//", 
    "Simplify"}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.8887286242119083`*^9, 3.888728733192758*^9}, 
   3.88883730857691*^9},
