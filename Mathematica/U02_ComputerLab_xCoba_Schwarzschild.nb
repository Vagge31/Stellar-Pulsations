Cell["\<\
Here is the definition of the coordinate system, and the metric:
Simply define the list coords = {....} and the matrix gmatrix\
\>", "Text",
 CellChangeTimes->{{3.888727629358975*^9, 3.888727638267356*^9}, {
  3.88872784886689*^9, 3.8887278531071978`*^9}, {3.888728536899967*^9, 
  3.888728561316792*^9}},ExpressionUUID->"76af4325-c92f-4d68-9f5d-\
696198fb95e3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"coords", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"t", "[", "]"}], ",", 
     RowBox[{"r", "[", "]"}], ",", 
     RowBox[{"\[Theta]", "[", "]"}], ",", 
     RowBox[{"\[Phi]", "[", "]"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DefConstantSymbol", "[", 
    RowBox[{"mass", ",", 
     RowBox[{"PrintAs", "\[Rule]", "\"\<M\>\""}]}], "]"}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"DefScalarFunction", "[", 
     RowBox[{"ascale", ",", 
      RowBox[{"PrintAs", "->", "\"\<a\>\""}]}], "]"}], ";", " ", 
    RowBox[{"Use", " ", "as", " ", 
     RowBox[{"e", ".", "g", ".", " ", 
      RowBox[{"ascale", "[", 
       RowBox[{
        RowBox[{"t", "[", "]"}], ",", 
        RowBox[{"r", "[", "]"}]}], "]"}]}], " ", "for", " ", "a", " ", 
     "function", " ", "of", " ", 
     RowBox[{"(", 
      RowBox[{"t", ",", "r"}], ")"}]}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gmatrix", " ", "=", " ", 
   RowBox[{"DiagonalMatrix", "[", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       RowBox[{"2", 
        FractionBox["mass", 
         RowBox[{"r", "[", "]"}]]}]}], ",", 
      FractionBox["1", 
       RowBox[{"1", "-", 
        RowBox[{"2", 
         FractionBox["mass", 
          RowBox[{"r", "[", "]"}]]}]}]], ",", 
      RowBox[{
       RowBox[{"r", "[", "]"}], "^", "2"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"r", "[", "]"}], "^", "2"}], 
       RowBox[{
        RowBox[{"Sin", "[", 
         RowBox[{"\[Theta]", "[", "]"}], "]"}], "^", "2"}]}]}], "}"}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DefChart", "[", 
   RowBox[{"ch", ",", "M", ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1", ",", "2", ",", "3"}], "}"}], ",", "coords", ",", 
    RowBox[{"ChartColor", "\[Rule]", "Blue"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{"CTensor", "[", 
    RowBox[{"gmatrix", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "ch"}], ",", 
       RowBox[{"-", "ch"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetCMetric", "[", 
   RowBox[{"g", ",", "ch", ",", 
    RowBox[{"SignatureOfMetric", "->", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", "1", ",", "0"}], "}"}]}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CD", " ", "=", " ", 
   RowBox[{"CovDOfMetric", "[", "g", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.88872764099708*^9, 3.888727843739778*^9}, {
   3.888728385012411*^9, 3.888728394248955*^9}, 3.88872846817772*^9, 
   3.888728510093655*^9, {3.888730441903105*^9, 3.8887304437497883`*^9}, {
   3.8887707352118053`*^9, 3.8887707801920357`*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"a03df076-2b02-409c-8122-9c2195841ee0"],

