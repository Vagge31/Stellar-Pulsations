Cell[TextData[{
 "Print nonzero components of Riemann: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["R", "\[Mu]"], "\[Nu]\[Rho]\[Sigma]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d2250790-e482-4b6e-810a-3968a68e39e7"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     SuperscriptBox["R", "\[Lambda]"], "\[Rho]\[Mu]\[Nu]"], " ", "=", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Mu]"], " ", 
      SubscriptBox[
       SuperscriptBox["\[CapitalGamma]", "\[Lambda]"], "\[Nu]\[Rho]"]}], "-", 
     
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Nu]"], " ", 
      SubscriptBox[
       SuperscriptBox["\[CapitalGamma]", "\[Lambda]"], "\[Mu]\[Rho]"]}], " ", 
     "+", " ", 
     RowBox[{
      SubscriptBox[
       SuperscriptBox["\[CapitalGamma]", "\[Lambda]"], "\[Mu]\[Sigma]"], " ", 
      
      SubscriptBox[
       SuperscriptBox["\[CapitalGamma]", "\[Sigma]"], "\[Nu]\[Rho]"]}], " ", 
     "-", " ", 
     RowBox[{
      SubscriptBox[
       SuperscriptBox["\[CapitalGamma]", "\[Lambda]"], "\[Nu]\[Sigma]"], " ", 
      
      SubscriptBox[
       SuperscriptBox["\[CapitalGamma]", "\[Sigma]"], "\[Mu]\[Rho]"]}]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "31f5057d-9dcd-4d21-bfa9-16aeedbe8a12"],
 "  (Carroll+Hartle\[CloseCurlyQuote]s convention)\nxCoba has Wald\
\[CloseCurlyQuote]s convention, which for a Levi-Civita Connection gives the \
same reult after some index raising/lowering.\n\nThe components of the \
Riemann tensor are collected by the ComponentArray[expr] function."
}], "Text",
 CellChangeTimes->{{3.888674660889804*^9, 3.888674670658424*^9}, {
  3.888675088935071*^9, 3.888675147320993*^9}, {3.888729266454825*^9, 
